```mermaid
graph TD
    M[main] --> PPD[prepare_pms_datasets]
    M --> PSD[process_service_data]
    
    %% Prepare PMS Datasets dependencies
    PPD --> GQD[get_quarter_dates]
    PPD --> EK[extract_k1 / extract_kk]
    PPD --> GBV[group_by_vin]

    %% Process Service Data dependencies
    PSD --> PMS1[derive_pms_features1]
    PSD --> NPMS[derive_npms_features]
    PSD --> PMS_Mil[derive_pms_mileage_features]
    PSD --> NPMS_Mil[derive_npms_mileage_features]
    PSD --> SI[derive_pms_service_intervals]
    SI --> ASI[adjust_service_intervals]
    
    PSD --> BVF[branch_visit_features]
    PSD --> BDF[branch_diversity_features]
    PSD --> LNM[get_last_nonpms_mileage]
    
    PSD --> NPE[get_non_pms_events]
    NPE --> LNPB[get_last_nonpms_before_targetpms]
    
    PSD --> APPT_L[compute_late_appointment_metrics]
    APPT_L --> MAS[map_appointments_to_services]
    
    PSD --> APPT_S[compute_last_appointment_status...]
    APPT_S --> DS[derive_status]
    
    PSD --> APPT_F[derive_appointment_show_features]
    PSD --> APPT_C[count_service_appointments_booked]
    
    PSD --> COMP[transform_complaint_features]
    
    PSD --> VHC[vhcpreparation]
    VHC --> CRB[compute_revenue_buckets]
    VHC --> SPB[split_parts_by_status]
    VHC --> RRS[red_revenue_split]
    
    PSD --> VHC_L[backfill_vhc_leakage_safe]
    VHC_L --> VHC_T[backfill_vhc_for_target_rows]
    
    PSD --> GOWER[hierarchical_gower_clustering]
    GOWER --> GM[gower_matrix]
    
    PSD --> OHE[one_hot]
    PSD --> CRS[calculate_revenue_spend]
    
    classDef root fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff;
    classDef primary fill:#5c2d91,stroke:#333,stroke-width:2px,color:#fff;
    classDef helper fill:#2d6a4f,stroke:#333,stroke-width:1px,color:#fff;
    
    class M root;
    class PPD,PSD primary;
    class GQD,EK,GBV,PMS1,NPMS,PMS_Mil,NPMS_Mil,SI,ASI,BVF,BDF,LNM,NPE,LNPB,APPT_L,MAS,APPT_S,DS,APPT_F,APPT_C,COMP,VHC,CRB,SPB,RRS,VHC_L,VHC_T,GOWER,GM,OHE,CRS helper;
```